DATABASE_URL=
VIEWER_ROLE=
INTERNAL_SHARED_SECRET=
# Server-side only. Never NEXT_PUBLIC_. The bot needs chat:write and must be a member of each channel.
# Leave the channel values empty until the real channel IDs are supplied (not Name). Do not invent them.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_LEGAL=
SLACK_CHANNEL_ENGINEER=

# SERVICE_ROLE selects which Cloud Run service this instance is: "dashboard" (sla-dashboard, internal ingress) or "ingestion" (sla-ingestion, public ingress). Required; a missing or unrecognised value stops the app at startup.
SERVICE_ROLE=
