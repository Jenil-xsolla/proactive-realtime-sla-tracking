# ---- Both services ----
# Which service this instance is: "dashboard" or "ingestion". Anything else stops startup.
SERVICE_ROLE=
# Server-side only. Never NEXT_PUBLIC_. The bot needs chat:write and must be a member of each channel.
SLACK_BOT_TOKEN=
# Shared secret for /api/internal/alerts/run: checked by sla-dashboard, sent by sla-ingestion and Cloud Scheduler.
INTERNAL_SHARED_SECRET=

# ---- sla-dashboard only ----
# Postgres as app_user (read sla_outages / sla_pir_reviews / sla_outage_corrections, write sla_alert_state).
DATABASE_URL=
VIEWER_ROLE=
# Leave the channel values empty until the real channel IDs are supplied (not Name). Do not invent them.
SLACK_CHANNEL_LEGAL=
SLACK_CHANNEL_ENGINEER=

# ---- sla-ingestion only ----
# Postgres as ingestion_writer (write sla_outages / sla_pir_reviews / sla_outage_corrections).
INGESTION_DATABASE_URL=
# Jira REST v3 read access, e.g. https://xsolla.atlassian.net
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Value Jira Automation sends in the Jira-Webhook-Token header.
JIRA_WEBHOOK_SECRET=
# Slack app signing secret, used to verify /api/slack/interactions.
SLACK_SIGNING_SECRET=
# Engineering channel for capture messages: C0BUT8U637Y
SLACK_CHANNEL_INGESTION=
# Internal URL of sla-dashboard, also the identity-token audience.
DASHBOARD_INTERNAL_URL=
