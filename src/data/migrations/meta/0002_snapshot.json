      "checkConstraints": {
        "sla_outages_source_check": {
          "name": "sla_outages_source_check",
          "value": "\"sla_outages\".\"source\" in ('pipeline','backfill')"
        },
        "sla_outages_decision_type_check": {
          "name": "sla_outages_decision_type_check",
          "value": "\"sla_outages\".\"decision_type\" is null or \"sla_outages\".\"decision_type\" in ('system_written','human_corrected')"
        },
        "sla_outages_decision_type_source_check": {
          "name": "sla_outages_decision_type_source_check",
          "value": "(\"sla_outages\".\"decision_type\" is null) = (\"sla_outages\".\"source\" = 'backfill')"
        },
        "sla_outages_reviewed_by_check": {
          "name": "sla_outages_reviewed_by_check",
          "value": "coalesce(\"sla_outages\".\"decision_type\" = 'human_corrected', false) = (\"sla_outages\".\"reviewed_by\" is not null)"
        },
        "sla_outages_reviewed_at_check": {
          "name": "sla_outages_reviewed_at_check",
          "value": "coalesce(\"sla_outages\".\"decision_type\" = 'human_corrected', false) = (\"sla_outages\".\"reviewed_at\" is not null)"
        },
        "sla_outages_outage_minutes_check": {
          "name": "sla_outages_outage_minutes_check",
          "value": "\"sla_outages\".\"outage_minutes\" > 0"
        }
